# deploy/.env — NOMES apenas. Copie para deploy/.env e preencha os valores no deploy.
# NUNCA comite este arquivo preenchido (gitignored). Mantenha modo 600.

# PostgreSQL (roda 01-schema.sql no primeiro boot de um volume vazio)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Senha da role somente-leitura rastro_viewer (Fase 7, API/viewer)
RASTRO_PG_VIEWER_PASSWORD=

# MQTT — senha do usuário `ingest` (somente LEITURA), criada com mosquitto_passwd (ver runbook).
# A senha do usuário `gateway` (ponte) NÃO mora aqui: a ponte é um processo do HOST e lê
# /etc/rastro/gateway.env (modo 600) — Fase 3. Usuário fixo: `ingest`.
RASTRO_MQTT_PASSWORD_INGEST=

# API/viewer (Fase 7) — token do monitor
RASTRO_API_TOKEN=
# `desativada` dispensa a senha do mapa SÓ para acesso local (Hosts de
# RASTRO_API_HOSTS_LOCAIS; protege contra Host externo/DNS rebinding). Acesso
# por outro nome ou perfil remote continua exigindo token. Túnel/porta-forward
# para 8080/8081 equivale a acesso local (entra sem senha) — com túnel, use
# modo `token`.
# RASTRO_API_AUTH=token
# RASTRO_API_HOSTS_LOCAIS=127.0.0.1:8081,localhost:8081,127.0.0.1:8080,localhost:8080,[::1]:8081,[::1]:8080
# RASTRO_SESSAO_DIAS=30 — prazo do "Lembrar neste computador" (1–90; decisão da equipe).

# Perfil remote (D8/R9, opcional — decisão da equipe): FQDN do proxy TLS reverso
# Usado com `docker compose --profile remote up -d caddy-remote`
RASTRO_PROXY_FQDN=
