# Rastro — broker mosquitto da imagem autoconfigurada (CapRover). SEM segredos neste
# arquivo: nem senhas nem chaves. Este é um MODELO: o entrypoint.sh substitui os
# marcadores @...@ pelos caminhos gerados em runtime (passwd hasheado, ACL renderizada,
# CA/certificado/chave — vindos de volume montado ou de variáveis de ambiente) e escreve
# o conf final num diretório privado (0700/0400) criado dentro de /tmp.
# Opções globais PRIMEIRO; depois o listener com suas opções de TLS/autenticação.
# Logs no stderr p/ o docker logs capturar (o ALERTA de fila cheia do R8 depende disto)
log_dest stderr
log_type error
log_type warning
log_type notice
# ATENÇÃO: mosquitto só aceita comentário em linha própria, com '#' na coluna 0 —
# nada de comentário à direita do valor nem continuação indentada (quebra o boot).

persistence true
# filas QoS 1 devem sobreviver a restarts do broker (T4)
persistence_location /mosquitto/data/
autosave_interval 300
# janela de perda ~5 min para mensagens ENFILEIRADAS (sessão ingest) num crash
# SUJO (kill -9 / queda de energia); uma parada limpa é segura. Aceito; ver R8.

# Limite de fila por sessão persistente offline (ingester fora do ar).
# Conta da malha: 288 posições + ~96 telemetrias por nó/dia = ~384/nó → 10 nós ≈
# 3.840 msg/dia (limite ANTERIOR de 20000 ≈ 5 DIAS — o atual, abaixo, é 100000)
# CRÍTICO: quando o limite é atingido, o mosquitto descarta a mensagem MAIS NOVA que chega
# (db__ready_for_queue, verificado no fonte master src/database.c) — e essas já estavam
# PUBACKed para a ponte ⇒ watermark avançou ⇒ spool podado ⇒ perda permanente, mais frescas
# primeiro. Logo: limite bem acima do equivalente em mensagens do spool, e linhas de log
# de fila cheia são ALERTADAS (R8), não apenas logadas.
max_queued_messages 100000
# ≈ 26 dias a 3.840 msg/dia (malha de 10 nós)
max_inflight_messages 20
# amigável ao padrão paho; mantém a ordenação por cliente

# O usuário do processo vem da IMAGEM (diretiva USER, uid não-root dono do volume de
# dados) — e não da diretiva `user` abaixo: nenhum setuid interno disputa com o
# orquestrador (fonte única de verdade). passwd/ACL/certs são sempre legíveis por esse
# uid; o entrypoint testa a escrita no volume de dados antes de subir o broker.
listener 8883 0.0.0.0
# o ÚNICO listener — nenhum listener sem TLS (porta texto) em lugar nenhum (D3)
protocol mqtt
cafile   @CAFILE@
certfile @CERTFILE@
keyfile  @KEYFILE@
tls_version tlsv1.2
allow_anonymous false
password_file @PASSWD@
acl_file      @ACL@
