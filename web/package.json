{
  "name": "rastro-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Visualizador de mapa local da malha Rastro (derivado de meshtastic/map, GPL-3.0-only)",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
