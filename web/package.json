    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@park-ui/tailwind-plugin": "^0.19.1",
    "@playwright/test": "^1.50.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^20.11.19",
    "autoprefixer": "^10.4.17",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.7",
    "vite-plugin-solid": "^2.10.1",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "@ark-ui/solid": "^2.1.1",
    "maplibre-gl": "^4.0.1",
    "pmtiles": "^3.0.5",
    "solid-js": "^1.8.15",
    "solid-phosphor": "^1.0.3",
